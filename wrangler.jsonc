{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hawiki-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www.hawiki.cz/*", "zone_name": "hawiki.cz" },
    { "pattern": "hawiki.cz/*", "zone_name": "hawiki.cz" },
    { "pattern": "www.hawiki.eu/*", "zone_name": "hawiki.eu" },
    { "pattern": "hawiki.eu/*", "zone_name": "hawiki.eu" }
  ],
  "previews": {}
}
